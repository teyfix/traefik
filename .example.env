# Copy this file to .env and replace every value that depends on your
# authorized tailnet, DNS suffix, subnet allocation, and local credentials.
# The root .env file is intentionally gitignored.

# Image versions
TRAEFIK_VER="v3.7.12"
STEPCA_VER="0.30.2"
DOZZLE_VER="v10.9.0"

# Shared Tailscale/CoreDNS runtime images
ALPINE_IMAGE="alpine:3.24.1"
COREDNS_IMAGE="coredns/coredns:1.14.7"
GOMPLATE_IMAGE="hairyhenderson/gomplate:v5.2.0-alpine"
TAILSCALE_IMAGE="tailscale/tailscale:v1.102.3"

# Step CA bootstrap values for a fresh local CA volume.
DOCKER_STEPCA_INIT_NAME="Local Dev CA"
DOCKER_STEPCA_INIT_DNS_NAMES="localhost,127.0.0.1,host.docker.internal"
DOCKER_STEPCA_INIT_REMOTE_MANAGEMENT="true"
DOCKER_STEPCA_INIT_ACME="true"

# Traefik label defaults
TRAEFIK_PREFIX="traefik"
TRAEFIK_DOMAIN="traefik.dev.example.test"
TRAEFIK_CERT_RESOLVER="stepca"
TRAEFIK_HTTPS_ENTRYPOINT="websecure"
TRAEFIK_TCP_ENTRYPOINT="shared"

# Tailscale subnet-router and split-DNS configuration (ingress-only design).
# Replace these examples with administrator-approved, non-overlapping values.
TS_HOSTNAME="docker-subnet-router"
TS_ROUTES="10.10.10.0/24"
TS_FORWARD_MSS="1160"
TS_INGRESS_SUBNET="10.10.10.0/24"
TS_DNS_SERVER="10.10.10.10"
TRAEFIK_IP="10.10.10.2"
TAIL_DOMAIN="dev.example.test"

# Authentication contract:
# TS_API_TOKEN is transient and provided only in the process environment.
# The reusable, ephemeral TS_AUTHKEY is stored only in the gitignored
# env/.env.tailscale.local file (mode 0600), never here. The persistent
# 'tailscale' Docker volume is retained across ordinary restarts.
