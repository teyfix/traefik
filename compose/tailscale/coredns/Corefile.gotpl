{{- $tailDomain := getenv "TAIL_DOMAIN" -}}
{{- $tailDomainEsc := $tailDomain | regexp.QuoteMeta -}}

{{ $tailDomain }} {
  log
  errors
  health :8080
  ready :8181

  template IN A {
    match ^(.*\.)?{{ $tailDomainEsc }}\.$
    answer "{{ "{{ .Name }}" }} 60 IN A {$TRAEFIK_IP}"
  }

  template IN AAAA {
    match ^(.*\.)?{{ $tailDomainEsc }}\.$
    rcode NOERROR
  }
}
