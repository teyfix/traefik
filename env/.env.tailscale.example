# Copy to env/.env.tailscale.local only for manual provisioning, then chmod 0600.
# The onboarding CLI creates this ignored file atomically. TS_API_TOKEN is
# onboarding-only and must never be placed here.
#
# Use a preauthorized, tagged, reusable, ephemeral key. Auth keys expire no
# later than 90 days; replace this file's key before then. The expiry metadata
# is operational guidance and is not passed to Tailscale.
TS_AUTHKEY="tskey-auth-REPLACE_WITH_A_REUSABLE_EPHEMERAL_KEY"
TS_AUTHKEY_EXPIRES_AT="2099-01-01T00:00:00.000Z"
